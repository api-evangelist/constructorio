        {
          "id": "81c49a8e-2ef3-4556-8e31-26d424619938",
          "name": "Retrieve Display Ads",
          "request": {
            "name": "Retrieve Display Ads",
            "description": {
              "content": "Retrieves ads for each of the given placements. Each placement maps to a typed response object. Banner placements return a single flattened ad; multi-banner placements return an array of ads ordered by auction rank. If no ad is available for a placement, the placement will be missing from the response. Placements are specified as repeated `placements` query parameters. Optionally, `num_results[{id}]=N` can be used to request a specific number of ads for a placement. When omitted, the placement's configured maximum is used.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "display-ads"
              ],
              "host": [
                "{{v2-display-ads-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) The key of the index to use."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Search query for keyword targeting."
                },
                {
                  "disabled": false,
                  "key": "filter_name",
                  "value": "<string>",
                  "description": "The name of the related browse filter."
                },
                {
                  "disabled": false,
                  "key": "filter_value",
                  "value": "<string>",
                  "description": "The value of the related browse filter."
                },
                {
                  "disabled": false,
                  "key": "num_results[key_0]",
                  "value": "<integer>",
                  "description": "Optional deepObject parameter to request a specific number of ads for each placement. Example: num_results[home_page]=3&num_results[carousel]=1. When omitted, the placement's configured maximum is used."
                },
                {
                  "disabled": false,
                  "key": "placements",
                  "value": "<string>",
                  "description": "(Required) Placement customer IDs to fetch ads for."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
