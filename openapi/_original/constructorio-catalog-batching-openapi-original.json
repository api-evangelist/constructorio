        "properties": {
          "keywords": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keywords",
            "description": "An array of keywords for this variation. Keywords are useful if you want a product name to appear when a user enters a search term that is not in the product name itself."
          },
